  <!-- ═══════════════════════════════════════════════════════════════════════
       GOVERNANCE — meta-controls applied to every delivery
       ═══════════════════════════════════════════════════════════════════════ -->
  <governance>
    <coe>
      <description>
        Center of Excellence. 5-seat board: Platform Lead, Compliance Lead, External
        Auditor, Reviewer-Agent Steward, Community Steward. Quorum = 3. Reviews
        delivery promotions, regulatory-impacting changes, new reviewer agents,
        protocol-bridge surface changes, and any delivery flagged ⚠️.
      </description>
      <triggers>
        <trigger>delivery.coe_gate="true"</trigger>
        <trigger>reviewer-agent registration</trigger>
        <trigger>BuildersRegistry.sol upgrade</trigger>
        <trigger>regulatory framework added or modified</trigger>
        <trigger>licensing change to any &#x1F507;&#x1F513; component</trigger>
        <trigger>upheld challenge → re-certification</trigger>
      </triggers>
      <sla>
        <review_window_hours>72</review_window_hours>
        <emergency_review_window_hours>4</emergency_review_window_hours>
        <quarterly_audit>required</quarterly_audit>
      </sla>
    </coe>

    <phases>
      <phase id="Ph.1" name="BUILD"     target_date="2026-09-30" description="Builders Program GA — bounty board, reviewer fleet, escrow, OSS adapter loop"/>
      <phase id="Ph.2" name="GOVERN"    target_date="2027-03-31" description="Federated orchestration, data lineage, COE re-certification, EU AI Act audit"/>
      <phase id="Ph.3" name="EVOLVE"    target_date="2027-09-30" description="Self-extending delivery loop, autonomous skill-library promotion, multi-LOB isolation"/>
      <phase id="Ph.4" name="COMPOUND"  target_date="continuous" description="Steady-state compound: Builders Program funds and extends itself via revenue share"/>
    </phases>

    <!--
      Economic model: pure donut economics under TSUL.

      No upfront grant. No prize. No synthetic token.

      A 49 bps donut is skimmed at settlement on every paid call / fill that
      flows through Taifoon, then auto-routed:
        70%  Creator       — the contributor whose adapter produced value
        20%  Reviewers     — PASS-voting reviewer agents that certified it
        10%  Ecosystem     — COE operations, audits, infra

      Performance only. A creator earns only if their work ships traffic.
      Reviewers earn only if their certifications survive challenge AND keep
      producing fills. Treasury fills only when the platform serves paid demand.

      Volume tier denotes expected throughput class, not an amount. Higher
      tier = larger expected donut slice over time, scaling with adapter
      adoption. License posture mirrors n8n's Sustainable Use License with
      one structural addition: the donut routing is enforced on-chain in
      BuildersRegistry, so any TSUL fork that runs the canonical contract
      kicks revenue back to the original creator/reviewer cohort.
    -->
    <license_posture default="TSUL">
      <license id="TSUL"       url="LICENSE-TSUL.md"    description="Taifoon Sustainable Use License — fair-code, n8n-pattern. Source-available; internal commercial use free; hosted-competing-service restricted."/>
      <license id="Apache-2.0" url="LICENSE-APACHE.txt" description="Permissive OSS — used for client SDKs, schemas, adapters."/>
      <license id="MIT"        url="LICENSE-MIT.txt"    description="Permissive OSS — used for templates, examples."/>
      <license id="ENTERPRISE" url="LICENSE-ENT.md"     description="Commercial enterprise license — removes TSUL hosted-service restriction. Required for SaaS partners offering managed Taifoon Intel."/>
    </license_posture>

    <regulatory_frameworks>
      <framework id="EU_AI_ACT"           articles="Art.9,Art.10,Art.11,Art.13,Art.14,Art.15"  description="Risk-management, data quality, technical documentation, transparency, human oversight, accuracy"/>
      <framework id="NIST_AI_RMF"         subcategories="GOVERN,MAP,MEASURE,MANAGE"           description="NIST AI Risk Management Framework 1.0"/>
      <framework id="ISO_IEC_42001"       version="2023"                                       description="AI management system — Annex A controls"/>
      <framework id="NAIC_MODEL_BULLETIN" scope="insurance"                                    description="US insurance LOB AI guidance"/>
      <framework id="GDPR"                articles="Art.5,Art.25,Art.32"                       description="Privacy-by-design, security of processing"/>
      <framework id="SOC2"                trust_criteria="Security,Availability,Confidentiality" description="Annual Type II audit"/>
    </regulatory_frameworks>

    <data_classification>
      <class id="PUBLIC"   description="Open-data, on-chain commitments, public docs"/>
      <class id="INTERNAL" description="Telemetry, contributor metadata (consent-gated)"/>
      <class id="CONFIDENTIAL" description="Submission tarballs pre-merge, reviewer signing keys"/>
      <class id="RESTRICTED"   description="Wallet-identity links (never persisted), HSM key material"/>
    </data_classification>
  </governance>

  <!-- ═══════════════════════════════════════════════════════════════════════
       STACK — chosen tools per platform category, matching the corporate
       buy/build/OSS framework. Each entry: vendor, role, alternatives.
       ═══════════════════════════════════════════════════════════════════════ -->
  <stack>

    <category id="protocol_bridge" phase="Ph.1" coe_gate="true" sourcing="&#x1F6D2;&#x1F513;">
      <description>
        Exposes Taifoon Builders Program over MCP, A2A, and REST. Any external
        agent platform (Palantir AIP, Vertex, Copilot Studio, custom) connects
        without bespoke integration.
      </description>
      <primary star="true">Solo.io Kgateway (Envoy-based, Apache 2.0, FIPS-compliant, mTLS)</primary>
      <alternatives>
        <alt>Kong Gateway (OSS/commercial, plugin ecosystem)</alt>
        <alt>Apigee (Google enterprise API management)</alt>
        <alt warning="true">AWS API Gateway + Lambda (simpler, higher lock-in)</alt>
        <alt warning="true">CAIPE protocol adapters (OSS Community only — no enterprise SLA)</alt>
      </alternatives>
      <ph1_scope>REST + MCP</ph1_scope>
      <ph2_scope>A2A mesh via SPIFFE/SPIRE</ph2_scope>
    </category>

    <category id="external_agent_registry" phase="Ph.1" sourcing="&#x1F6D2;">
      <description>
        Registers agents built on external platforms so Taifoon Agent Core can
        invoke them in governed deliveries. Discovery, health signalling,
        capability declaration with scoped whitelist.
      </description>
      <primary star="true">Solo.io Agentregistry (extends to external agents via MCP)</primary>
      <alternatives>
        <alt>Google Agent Space (if GCP primary)</alt>
        <alt>Microsoft Copilot Studio connector catalog (if Azure-heavy)</alt>
        <alt warning="true">DynamoDB (key-value only — no discovery/health/capability semantics)</alt>
      </alternatives>
    </category>

    <category id="federated_orchestration" phase="Ph.2" sourcing="&#x1F6D2;&#x1F527;">
      <description>
        Orchestrates Builders Program deliveries across agents regardless of
        origin platform. Every cross-platform call logged to the Audit Trail.
      </description>
      <primary star="true">Step Functions + EventBridge + Protocol Bridge routing</primary>
      <alternatives>
        <alt>Temporal (cross-service durable workflows, stronger guarantees)</alt>
