  <!-- ═══════════════════════════════════════════════════════════════════════
       DELIVERY LOOP — explicit feedback edges. The roadmap delivers itself.
       Each <edge> says: when delivery N produces <output>, it auto-creates
       deliveries of type <generates> (handled by orchestrator.py).
       ═══════════════════════════════════════════════════════════════════════ -->
  <delivery_loop>
    <description>
      The Builders Program is self-extending. Six feedback loops mean every
      shipped delivery produces inputs that automatically generate more
      deliveries — without human triage. COE retains kill-switch authority on
      every loop (via &lt;coe_gate&gt;).
    </description>

    <edge id="loop-1-anomaly-to-fix">
      <name>Anomaly → Fix Bounty</name>
      <source_delivery>anomaly-scanner-agent</source_delivery>
      <output>fix_bounty_v1 record (protocol, chain, observed_divergence, severity)</output>
      <generates>delivery type="bounty" category="decoder-gap" tier from severity</generates>
      <automation>autonomous</automation>
      <coe_gate>false</coe_gate>
      <sla_to_publish_hours>1</sla_to_publish_hours>
    </edge>

    <edge id="loop-2-protocol-upgrade-to-refresh">
      <name>Protocol Upgrade → Adapter Refresh Bounty</name>
      <source_delivery>protocol-upgrade-detector</source_delivery>
      <output>upgrade_event_v1 (protocol, new_version, breaking_change_flag)</output>
      <generates>delivery type="bounty" category="decoder-refresh" tier="MEDIUM"</generates>
      <automation>autonomous</automation>
      <coe_gate>false</coe_gate>
      <right_of_first_refusal_hours>72</right_of_first_refusal_hours>
    </edge>

    <edge id="loop-3-perf-regression-to-bounty">
      <name>Performance Regression → Optimisation Bounty</name>
      <source_delivery>telemetry-harness</source_delivery>
      <output>regression_v1 (adapter_id, p95_delta_ms, started_at)</output>
      <generates>delivery type="bounty" category="optimisation" tier="LOW"</generates>
      <automation>autonomous</automation>
      <coe_gate>false</coe_gate>
    </edge>

    <edge id="loop-4-skill-extraction">
      <name>Common-Pattern → Skill-Library Promotion</name>
      <source_delivery>pattern-miner-agent</source_delivery>
      <output>skill_candidate_v1 (pattern, frequency, supporting_adapters[])</output>
      <generates>delivery type="skill_promotion" — extracted, certified, published</generates>
      <automation>semi-autonomous</automation>
      <coe_gate>true</coe_gate>
      <description>Common patterns across LOBs become Skill Library entries; next contributor starts from certified blocks.</description>
    </edge>

    <edge id="loop-5-reviewer-evolution">
      <name>Inconclusive Verdict → New Reviewer Bounty</name>
      <source_delivery>orchestrator</source_delivery>
      <output>inconclusive_pattern_v1 (frequency &gt;= 5, scope_gap_description)</output>
      <generates>delivery type="reviewer-agent" tier="PLATFORM"</generates>
      <automation>semi-autonomous</automation>
      <coe_gate>true</coe_gate>
    </edge>

    <edge id="loop-6-revenue-to-treasury-to-bounties">
      <name>Adapter Revenue → Treasury → New Bounty Funding</name>
      <source_delivery>BuildersRegistry.recordRevenueTouch</source_delivery>
      <output>protocol fee accrual to treasury</output>
      <generates>BountyEscrow.fund() of next-priority bounty per <funding_policy/></generates>
      <automation>autonomous (after Ph.4)</automation>
      <coe_gate>false</coe_gate>
      <funding_policy>quarterly: 20% to high-severity gap closure, 30% to FLAGSHIP queue, 30% to platform-tier deliveries, 20% to reviewer stake top-up</funding_policy>
    </edge>
  </delivery_loop>

