{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://taifoon.dev/schemas/fill_event_v1.json",
  "title": "Fill Event v1 (canonical)",
  "description": "Canonical cross-chain fill event emitted by Taifoon protocol decoders. Every adapter under bounties.xml MUST emit shards conforming to this schema.",
  "type": "object",
  "required": [
    "schema_version",
    "src_chain",
    "dst_chain",
    "protocol",
    "asset",
    "amount_native",
    "amount_usd",
    "request_ts",
    "fill_ts",
    "tx_hash_src",
    "tx_hash_dst"
  ],
  "properties": {
    "schema_version":    {"type": "string", "const": "fill_event_v1"},
    "src_chain":         {"type": ["integer", "string"], "description": "EVM chainId or chain slug for non-EVM"},
    "dst_chain":         {"type": ["integer", "string"]},
    "protocol":          {"type": "string", "description": "slug from protocols.xml"},
    "bridge_protocol":   {"type": "string", "description": "Optional sub-protocol (e.g. 'taifoon-surge-btc')"},
    "asset":             {"type": "string", "description": "Symbol or contract address"},
    "asset_dst":         {"type": "string", "description": "Destination asset (cross-denom only)"},
    "amount_native":     {"type": "string", "pattern": "^\\d+$", "description": "Decimal-formatted native amount, no scientific notation"},
    "amount_usd":        {"type": "number", "minimum": 0},
    "fee_bps":           {"type": "number"},
    "fee_amount_native": {"type": "string"},
    "request_ts":        {"type": "integer", "description": "Unix timestamp ms of deposit"},
    "fill_ts":           {"type": "integer", "description": "Unix timestamp ms of fill"},
    "fill_latency_ms":   {"type": "integer", "minimum": 0},
    "intent_hash":       {"type": "string"},
    "order_id":          {"type": "string"},
    "solver_addr":       {"type": "string"},
    "user_addr":         {"type": "string"},
    "tx_hash_src":       {"type": "string"},
    "tx_hash_dst":       {"type": "string"},
    "block_src":         {"type": "integer"},
    "block_dst":         {"type": "integer"},
    "log_index_src":     {"type": "integer"},
    "log_index_dst":     {"type": "integer"},
    "fee_confidence":    {"type": "string", "enum": ["high", "medium", "low", "none"]}
  },
  "additionalProperties": false
}
