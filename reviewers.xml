<?xml version="1.0" encoding="UTF-8"?>
<!--
  ╔══════════════════════════════════════════════════════════════════════╗
  ║  reviewers.xml — open-mamba reviewer agent registry                   ║
  ║  Owner: yawningmonsoon | Updated: 2026-05-08 | Version: 0.1          ║
  ║                                                                        ║
  ║  Canonical registry of autonomous reviewer agents.                    ║
  ║  Read by: open-mamba/orchestrator.py (scope only)                     ║
  ║           taifoon-eco/src/BuildersRegistry.sol (proposed)             ║
  ║                                                                        ║
  ║  Each <reviewer> is itself a versioned adapter — anyone can submit a  ║
  ║  new reviewer through the Builders Program. Reviewer adapters are     ║
  ║  reviewed by the platform-checker reviewer + manual approval for the  ║
  ║  initial bootstrap period.                                            ║
  ║                                                                        ║
  ║  Verdict types: pass | fail | inconclusive                            ║
  ║  Stake_foon is locked at registration, slashable on counter-example.  ║
  ╚══════════════════════════════════════════════════════════════════════╝
-->
<reviewers version="0.1" project="open-mamba" generated="2026-05-08" owner="yawningmonsoon">

  <verdict_schema>
    <field name="reviewer_id"      type="string"  description="Slug from <reviewer>"/>
    <field name="reviewer_version" type="string"  description="Semver of reviewer adapter"/>
    <field name="bounty_id"        type="string"  description="From bounties.xml"/>
    <field name="submission_hash"  type="bytes32" description="sha256 of submission tarball"/>
    <field name="verdict"          type="enum"    values="pass,fail,inconclusive"/>
    <field name="reason_code"      type="string"  description="Structured reason; see reason_codes/"/>
    <field name="reason_detail"    type="string"  description="Free-text detail (max 512 chars)"/>
    <field name="replay_block_set" type="string"  description="Path to the replay block set used"/>
    <field name="signed_at"        type="uint64"  description="Unix timestamp"/>
    <field name="signature"        type="bytes"   description="Reviewer agent key signature"/>
  </verdict_schema>

  <reason_codes>
    <code id="REPLAY_MATCH"          verdict="pass" description="Output matches reference for all replay blocks"/>
    <code id="SCHEMA_CONFORMS"       verdict="pass" description="Output schema-exact against fill_event_v1"/>
    <code id="ADVERSARIAL_PASSED"    verdict="pass" description="Adversarial test set fully passed"/>
    <code id="ORACLE_RESOLVED"       verdict="pass" description="Cross-denom oracle wiring verified end-to-end"/>
    <code id="REPLAY_DIFF"           verdict="fail" description="Replay output diverged from reference"/>
    <code id="SCHEMA_INVALID"        verdict="fail" description="Output failed schema conformance"/>
    <code id="PERF_BUDGET_EXCEEDED"  verdict="fail" description="p95 decode latency exceeded budget"/>
    <code id="REORG_UNSAFE"          verdict="fail" description="Output emitted before finality"/>
    <code id="DUP_HANDLING_INVALID"  verdict="fail" description="Duplicate logIndex handling broken"/>
    <code id="LICENSE_MISSING"       verdict="fail" description="SPDX header missing"/>
    <code id="INSUFFICIENT_FIXTURES" verdict="inconclusive" description="Reference set too small to vote confidently"/>
    <code id="NOVEL_PROTOCOL_BEHAVIOR" verdict="inconclusive" description="Behavior outside reviewer's test coverage"/>
    <code id="ENCLAVE_FAILURE"       verdict="inconclusive" description="Confidential-compute enclave errored mid-replay"/>
  </reason_codes>

  <!-- ═══════════════════════════════════════════════════════════════════
       REPLAY-CLASS REVIEWERS — chain-specific historical replay
       ═══════════════════════════════════════════════════════════════════ -->

