  <!-- ═══════════════════════════════════════════════════════════════════
       SCHEMA / PROPERTY REVIEWERS — chain-agnostic, output-shape gates
       ═══════════════════════════════════════════════════════════════════ -->

  <reviewer slug="schema-conformer" stake_foon="25000" status="active">
    <name>Canonical Schema Conformer</name>
    <scope>fill_event_v1, deposit_event_v1, solver_dossier_v1, route_coverage_v1</scope>
    <approves>all categories — runs as second reviewer on every bounty</approves>
    <enforces>
      <rule>All required fields present and correctly typed</rule>
      <rule>USD value reconciled against on-chain price oracle within ±25 bps</rule>
      <rule>request_ts &lt; fill_ts</rule>
      <rule>chain_id integers match canonical registry</rule>
      <rule>solver_addr lowercased + checksummed (EVM) or base58 (sol)</rule>
    </enforces>
    <enclave>not required (deterministic property checks)</enclave>
  </reviewer>

  <reviewer slug="oracle-checker" stake_foon="25000" status="active">
    <name>Cross-denom Oracle Checker</name>
    <scope>USD oracle wiring for cross-denom protocols (Mayan, deBridge, Meson, etc.)</scope>
    <approves>oracle category bounties</approves>
    <enforces>
      <rule>Oracle source whitelisted (Chainlink, Pyth, Uniswap V3 TWAP, internal)</rule>
      <rule>Cross-source consensus check enabled when 2+ oracles available</rule>
      <rule>Stale-price guard: reject if oracle older than chain-specific threshold</rule>
    </enforces>
    <enclave>not required</enclave>
  </reviewer>

  <reviewer slug="aggregator-decomposer" stake_foon="25000" status="active">
    <name>Aggregator Route Decomposer</name>
    <scope>Li.Fi, Socket, Squid, Rango, 1inch decomposition</scope>
    <approves>aggregator-decomp category</approves>
    <enforces>
      <rule>Underlying bridge attributed correctly per inner call</rule>
      <rule>Volume sum across underlying bridges == aggregator deposit</rule>
      <rule>No double-counting in fill attribution</rule>
    </enforces>
    <enclave>not required</enclave>
  </reviewer>

  <reviewer slug="dossier-builder" stake_foon="25000" status="active">
    <name>Solver Dossier Format Validator</name>
    <scope>solver_dossier_v1, route_coverage_v1, dossier-promotion bounties</scope>
    <approves>dossier category, LOW-tier promotion bounties</approves>
    <enforces>
      <rule>Solver address registered with first-seen block</rule>
      <rule>Fill latency p50/p95 computed over &gt;=100 fills</rule>
      <rule>Spread deviation reference price documented</rule>
      <rule>Route coverage matrix dimensions match chain registry</rule>
    </enforces>
    <enclave>not required</enclave>
  </reviewer>

  <reviewer slug="platform-checker" stake_foon="25000" status="active">
    <name>Platform Submission Checker</name>
    <scope>Phase 5/6 platform bounties, changes to BUILDERS_PROGRAM.md and bounties.xml</scope>
    <approves>platform-phase5, platform-phase6, spec changes</approves>
    <enforces>
      <rule>SSE backpressure handling implemented</rule>
      <rule>Service binary integrates with existing systemd unit pattern</rule>
      <rule>No regression in DA-API health check</rule>
      <rule>Spec changes preserve cross-references between protocols.xml + bounties.xml</rule>
    </enforces>
    <enclave>not required</enclave>
  </reviewer>

